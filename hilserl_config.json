{
    "env": {
        "type": "gym_manipulator",
        "name": "real_robot",
        "fps": 10,
        "robot": {
            "type": "so101_follower",
            "port": "/dev/ttyACM0",
            "id": "R12255108",
            "cameras": {
                "handeye": {
                    "type": "opencv",
                    "index_or_path": 4,
                    "width": 640,
                    "height": 480,
                    "fps": 30
                }
            }
        },
        "teleop": {
            "type": "so101_leader",
            "port": "/dev/ttyACM1",
            "id": "R07255108",
            "use_degrees": true
        },
        "processor": {
            "control_mode": "leader",
            "observation": {
                "add_joint_velocity_to_observation": true,
                "display_cameras": true
            },
            "image_preprocessing": {},
            "inverse_kinematics": {
                "urdf_path": "lerobot/configs/robots/SO101/so101_new_calib.urdf",
                "target_frame_name": "moving_arm_flange",
                "end_effector_bounds": {
                    "min": [
                        0.15,
                        -0.1,
                        0.02
                    ],
                    "max": [
                        0.30,
                        0.1,
                        0.15
                    ]
                }
            },
            "reset": {
                "reset_time_s": 5.0,
                "control_time_s": 20.0,
                "terminate_on_success": true
            }
        }
    },
    "dataset": {
        "repo_id": "yhbcode000/so101_hilserl_grab"
    },
    "policy": {
        "type": "sac",
        "pretrained_path": "outputs/train/smolvla_grab/checkpoints/last/pretrained_model",
        "device": "cuda"
    },
    "mode": "record",
    "device": "cuda"
}